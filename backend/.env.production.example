# Template only: NEVER commit actual credentials or connect to a production database casually.
NODE_ENV=production
PORT=10000
FRONTEND_ORIGIN=https://app.example.com
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/expense_tracker?sslmode=require
JWT_SECRET=REPLACE_WITH_A_UNIQUE_64_CHAR_RANDOM_SECRET
# 0 means do not trust proxy headers; set only after verifying platform proxy topology.
TRUST_PROXY_HOPS=1
ENABLE_API_DOCS=false
