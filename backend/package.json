{
  "name": "expense-tracker-api",
  "version": "1.0.0-rc.1",
  "private": true,
  "scripts": {
    "start:dev": "nest start --watch",
    "build": "nest build",
    "start:prod": "node dist/main.js",
    "db:migrate": "node scripts/migrate.cjs",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "qa:unit": "node --test scripts/qa/metrics.test.mjs",
    "qa:integration": "node scripts/qa/run-local-integration.mjs",
    "qa:all": "npm run test && npm run typecheck && npm run build && npm run qa:unit && npm run qa:integration",
    "qa:server": "node scripts/qa/start-qa-api.mjs",
    "ops:cleanup": "node scripts/ops/cleanup_auth_data.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/jwt": "^11.0.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "@nestjs/swagger": "^11.2.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.9.0"
  }
}
