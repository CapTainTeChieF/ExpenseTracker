NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://expense_user:local_dev_password_change_me@localhost:5433/expense_tracker
# Replace with a unique random 32+ byte secret before running. Do NOT commit .env.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Disabled by default when NODE_ENV=production; turn on only behind an authorized network.
ENABLE_API_DOCS=false
